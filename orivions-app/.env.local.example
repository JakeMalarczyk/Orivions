# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default in Next.js - never commit real keys.

# Supabase - anon key is safe to expose client-side (Row Level Security enforces real access control),
# but keeping it in env vars (not hardcoded in a committed .js file) means you can use different
# keys per environment (dev/staging/prod) and rotate them without touching code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key - server-side ONLY (never NEXT_PUBLIC). All public form writes
# (waitlist, leads, tracking) go through API routes that use it, since anonymous inserts are revoked.
SUPABASE_SERVICE_ROLE_KEY=

# Site URL, used for canonical/OG tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://orivions.com

# Anthropic API key - server-side ONLY (never prefixed NEXT_PUBLIC, never exposed to the browser).
# Powers /api/smart-match and /api/ai-proposal. Without it, the AI matching features return an error.
# Get one at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Cloudflare Turnstile (captcha) for login, signup, waitlist and Smart Match.
# Create a widget at https://dash.cloudflare.com -> Turnstile. The site key is public;
# the secret key is server-side ONLY. Also paste the secret into Supabase ->
# Authentication -> Attack Protection so Supabase Auth verifies login/signup tokens.
# Leave both empty to run without a captcha.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Telegram notifications to the admin (new concierge requests, signups,
# verification requests, contact requests). Create a bot with @BotFather, send it
# /start from your account, and get your numeric user id from @userinfobot.
# Leave empty to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
