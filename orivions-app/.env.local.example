# Copy this file to .env.local and fill in real values.
# .env.local is gitignored by default in Next.js — never commit real keys.

# Supabase — anon key is safe to expose client-side (Row Level Security enforces real access control),
# but keeping it in env vars (not hardcoded in a committed .js file) means you can use different
# keys per environment (dev/staging/prod) and rotate them without touching code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL, used for canonical/OG tags and sitemap generation.
NEXT_PUBLIC_SITE_URL=https://orivions.xyz

# Anthropic API key - server-side ONLY (never prefixed NEXT_PUBLIC, never exposed to the browser).
# Powers /api/smart-match and /api/ai-proposal. Without it, the AI matching features return an error.
# Get one at https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=sk-ant-your-key-here
